        .eleccia-button-embed {
          position: relative;
          width: 100%;
          min-height: 200px;
          background: linear-gradient(135deg, #ffffff 0%, #f9fafb 100%);
          overflow: hidden;
          padding: 2rem;
          box-sizing: border-box;
        }

        /* Radial glow effect */
        .radial-glow-overlay {
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          pointer-events: none;
          z-index: 1;
          background: radial-gradient(
            ellipse 120% 100% at 20% 50%,
            transparent 15%,
            rgba(205, 19, 22, 0.03) 30%,
            rgba(205, 19, 22, 0.08) 50%,
            rgba(205, 19, 22, 0.15) 100%
          );
          animation: glow-pulse 3s ease-in-out infinite;
        }

        @keyframes glow-pulse {
          0%, 100% {
            opacity: 0.8;
          }
          50% {
            opacity: 1;
          }
        }

        /* Waves effect */
        .waves-container {
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          pointer-events: none;
          z-index: 2;
          overflow: hidden;
        }

        .wave {
          position: absolute;
          top: 50%;
          left: 10%;
          width: 300px;
          height: 300px;
          border: 2px solid rgba(205, 19, 22, 0.1);
          border-radius: 50%;
          transform: translate(-50%, -50%);
          animation: wave-expand 3s ease-out infinite;
        }

        .wave-2 {
          animation-delay: 1s;
          border-color: rgba(205, 19, 22, 0.08);
        }

        .wave-3 {
          animation-delay: 2s;
          border-color: rgba(205, 19, 22, 0.06);
        }

        @keyframes wave-expand {
          0% {
            transform: translate(-50%, -50%) scale(0.3);
            opacity: 1;
          }
          100% {
            transform: translate(-50%, -50%) scale(2);
            opacity: 0;
          }
        }

        /* Main container */
        .button-container {
          position: relative;
          z-index: 3;
          display: flex;
          align-items: center;
          gap: 2rem;
          max-width: 900px;
          margin: 0 auto;
        }

        /* Avatar section */
        .avatar-section {
          display: flex;
          flex-direction: column;
          align-items: center;
          gap: 1rem;
        }

        .avatar-container {
          position: relative;
          width: 140px;
          height: 140px;
          display: flex;
          align-items: center;
          justify-content: center;
        }

        .avatar-media {
          position: absolute;
          width: 100%;
          height: 100%;
          object-fit: cover;
          object-position: center 35%;
          transition: opacity 0.35s ease-in-out;
          border-radius: 50%;
        }

        /* Floating animation */
        .avatar-image.floating {
          animation: float-bob 4s ease-in-out infinite;
        }

        @keyframes float-bob {
          0%, 100% {
            transform: translateY(0);
          }
          50% {
            transform: translateY(-18px);
          }
        }

        /* Logo */
        .logo-container {
          display: flex;
          justify-content: center;
        }

        .eleccia-logo {
          width: 120px;
          height: auto;
          object-fit: contain;
        }

        /* Text section */
        .text-section {
          flex: 1;
          display: flex;
          flex-direction: column;
          gap: 0.75rem;
        }

        .main-title {
          font-size: 1.75rem;
          font-weight: 700;
          color: #1f2937;
          margin: 0;
          line-height: 1.2;
        }

        .subtitle {
          font-size: 1.125rem;
          color: #6b7280;
          margin: 0;
          line-height: 1.5;
        }

        .brand-name {
          font-weight: 600;
          color: #CD1316;
        }

        /* Responsive design */
        @media (max-width: 640px) {
          .eleccia-button-embed {
            padding: 1.5rem;
            min-height: 300px;
          }

          .button-container {
            flex-direction: column;
            gap: 1.5rem;
            text-align: center;
          }

          .avatar-container {
            width: 120px;
            height: 120px;
          }

          .main-title {
            font-size: 1.5rem;
          }

          .subtitle {
            font-size: 1rem;
          }

          .eleccia-logo {
            width: 100px;
          }
        }

        @media (max-width: 480px) {
          .avatar-container {
            width: 100px;
            height: 100px;
          }

          .main-title {
            font-size: 1.25rem;
          }

          .subtitle {
            font-size: 0.875rem;
          }

          .eleccia-logo {
            width: 80px;
          }
        }
      `})]})},UB=()=>{const[i,e]=N.useState(1),[t,n]=N.useState(0),r=N.useRef(null),a=N.useRef(null);return N.useRef("image"),N.useEffect(()=>{window.gtag&&window.gtag("event","page_view",{page_title:"Embed EleccIA Button Overlay",page_location:window.location.href,page_path:"/embed/eleccia-overlay"}),r.current&&r.current.load();let o="image";return a.current=setInterval(()=>{if(o==="image"){const u=r.current;u&&(u.currentTime=0,u.play().then(()=>{e(0),n(1),o="video"}).catch(f=>console.error("Error playing video:",f)))}else{const u=r.current;e(1),n(0),o="image",setTimeout(()=>{u&&u.pause()},400)}},5e3),()=>{a.current&&clearInterval(a.current),r.current&&r.current.pause()}},[]),c.jsxs("div",{className:"eleccia-button-v2-embed",children:[c.jsx("div",{className:"button-base",children:c.jsx("img",{src:"/boton-ia.png",alt:"EleccIA Button",className:"button-background"})}),c.jsxs("div",{className:"logo-overlay-container",children:[c.jsx("div",{className:"radial-glow"}),c.jsxs("div",{className:"waves-container",children:[c.jsx("div",{className:"wave wave-1"}),c.jsx("div",{className:"wave wave-2"}),c.jsx("div",{className:"wave wave-3"})]}),c.jsxs("div",{className:"avatar-wrapper",children:[c.jsx("img",{src:"/eleccia-idle.png",alt:"EleccIA Avatar",className:"avatar-media floating",style:{opacity:i}}),c.jsx("video",{ref:r,src:"/eleccia-idle-moving.mp4",className:"avatar-media",style:{opacity:t},muted:!0,playsInline:!0})]})]}),c.jsx("style",{children:`
        .eleccia-button-v2-embed {
          position: relative;
          width: 100%;
          height: 100%;
          min-height: 150px;
          display: flex;
          align-items: center;
          justify-content: center;
          overflow: hidden;
          padding: 0;
          margin: 0;
        }

        /* Imagen base del botón */
        .button-base {
          position: relative;
          width: 100%;
          max-width: 500px;
          margin: 0 auto;
        }

        .button-background {
          width: 100%;
          height: auto;
          display: block;
          border-radius: 12px;
        }

        /* Container del overlay (40% izquierdo) */
        .logo-overlay-container {
          position: absolute;
          left: 0;
          top: 0;
          bottom: 0;
          width: 40%;
          max-width: 220px;
          display: flex;
          align-items: center;
          justify-content: flex-start;
          overflow: visible;
          border-radius: 12px 0 0 12px;
          padding: 0;
          margin: 0;
        }

        /* Radial glow effect */
        .radial-glow {
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          pointer-events: none;
          z-index: 1;
          background: radial-gradient(
            circle at center,
            transparent 20%,
            rgba(255, 255, 255, 0.05) 40%,
            rgba(255, 255, 255, 0.1) 70%,
            rgba(255, 255, 255, 0.15) 100%
          );
          animation: glow-pulse 3s ease-in-out infinite;
        }

        @keyframes glow-pulse {
          0%, 100% {
            opacity: 0.6;
          }
          50% {
            opacity: 1;
          }
        }

        /* Waves effect */
        .waves-container {
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          bottom: 0;
          pointer-events: none;
          z-index: 2;
          overflow: hidden;
        }

        .wave {
          position: absolute;
          top: 50%;
          left: 50%;
          width: 80px;
          height: 80px;
          border: 2px solid rgba(255, 255, 255, 0.3);
          border-radius: 50%;
          transform: translate(-50%, -50%);
          animation: wave-expand 3s ease-out infinite;
        }

        .wave-2 {
          animation-delay: 1s;
          border-color: rgba(255, 255, 255, 0.2);
        }

        .wave-3 {
          animation-delay: 2s;
          border-color: rgba(255, 255, 255, 0.1);
        }

        @keyframes wave-expand {
          0% {
            transform: translate(-50%, -50%) scale(0.5);
            opacity: 1;
          }
          100% {
            transform: translate(-50%, -50%) scale(2.5);
            opacity: 0;
          }
        }

        /* Avatar wrapper */
        .avatar-wrapper {
          position: relative;
          z-index: 3;
          width: 100%;
          height: 100%;
          display: flex;
          align-items: center;
          justify-content: flex-start;
          padding: 0;
          margin: 0;
        }

        .avatar-media {
          position: absolute;
          left: 0;
          top: 0;
          width: 110%;
          height: 110%;
          object-fit: contain;
          transition: opacity 0.35s ease-in-out;
          margin: 0;
          padding: 0;
        }

        /* Floating animation para la imagen */
        .avatar-media.floating {
          animation: float-bob 4s ease-in-out infinite;
        }

        @keyframes float-bob {
          0%, 100% {
            transform: translateY(0);
          }
          50% {
            transform: translateY(-15px);
          }
        }

        /* Responsive adjustments */
        @media (max-width: 480px) {
          .button-base {
            max-width: 100%;
          }

          .logo-overlay-container {
            max-width: 100px;
          }

          .wave {
            width: 60px;
            height: 60px;
          }
        }

        @media (min-width: 768px) {
          .button-base {
            max-width: 600px;
          }

          .logo-overlay-container {
            max-width: 240px;
